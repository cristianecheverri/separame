# Local development only. Deployed builds read /app/config.json (written by CDK).
# Copy to .env.local and fill with the dev stage outputs.
VITE_API_URL=https://api.dev.separame.app
VITE_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_AWS_REGION=us-east-1
VITE_STAGE=dev
VITE_SITE_URL=https://dev.separame.app

# 1 = serve the whole app against the in-memory mock API with a fake session
# (no AWS calls). Query switches (remembered per tab): ?as=pro|admin|guest,
# ?state=trial|active|grace|expired|onboarding, ?billing=none|pending|rejected, ?delay=<ms>.
VITE_MOCK=0
