{
  "name": "separame-cdk",
  "version": "0.1.0",
  "private": true,
  "description": "Sepárame infrastructure (AWS CDK, TypeScript).",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "cdk": "cdk",
    "synth:dev": "cdk synth --all -c stage=dev --quiet",
    "synth:prod": "cdk synth --all -c stage=prod --quiet",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.274.0",
    "constructs": "^10.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "aws-cdk": "^2.1146.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
